# ===== Firebase (クライアント) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (サーバー / サービスアカウント) =====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 改行は \n のまま1行で貼り付け
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== LINE =====
# LIFFアプリID（LINE Loginチャネル内で作成）
NEXT_PUBLIC_LIFF_ID=
# LINE LoginチャネルのチャネルID（IDトークン検証用）
LINE_LOGIN_CHANNEL_ID=
# Messaging APIチャネルのチャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# 公式アカウント友だち追加URL（https://lin.ee/xxxx）
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# ===== 運用パラメータ =====
# 1回のヘルプで通知する最大人数（LINE通数コスト制御）
MAX_NOTIFY=30
# 「最後にいた場所」を通知判定に使う時間
LAST_SEEN_HOURS=6
# 24時間あたりのヘルプコール上限
DAILY_CALL_LIMIT=3
